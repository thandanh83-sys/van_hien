# =====================================================================
# VĂN ĐẠO ENGINE - TỆP CẤU HÌNH GITIGNORE (v2.0 - Knowledge Network)
# Mục đích: Ngăn chặn các tệp rác, tệp tạm, và thông tin nhạy cảm
# bị đẩy lên GitHub. Giữ cho kho lưu trữ luôn nhẹ, sạch và thanh tịnh.
# =====================================================================

# ---------------------------------------------------------------------
# 1. HỆ ĐIỀU HÀNH (OS FILES)
# ---------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
.directory
.Trash-*
.nfs*

# ---------------------------------------------------------------------
# 2. TRÌNH SOẠN THẢO & IDE (EDITORS / IDEs)
# ---------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains (WebStorm, PyCharm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Cursor / Windsurf (AI Code Editors thế hệ mới)
.cursor/
.windsurf/
*.cursorrules

# ---------------------------------------------------------------------
# 3. MÔI TRƯỜNG PYTHON (PYTHON ARTIFACTS)
# Rất quan trọng vì dự án dùng Python tools (tools/*.py)
# ---------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Môi trường ảo (Virtual Environments)
.venv/
venv/
ENV/
env/
.env
.env.local
.env.*
!.env.example

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.pytest_cache
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv / poetry
Pipfile.lock
poetry.lock

# ---------------------------------------------------------------------
# 4. MÔI TRƯỜNG NODE.JS & BUILD TOOLS (NODE ARTIFACTS)
# Dự phòng cho việc chạy local server (npx http-server)
# ---------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.npm/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.next/
.nuxt/
dist/
out/
build/

# ---------------------------------------------------------------------
# 5. NHẬT KÝ & TỆP TẠM (LOGS & TEMP FILES)
# ---------------------------------------------------------------------
*.log
*.log.*
logs/
*.tmp
*.temp
.cache/
.temp/
.tmp/
*.bak
*.orig
*.pid
*.seed
*.pid.lock

# ---------------------------------------------------------------------
# 6. BẢO MẬT & CẤU HÌNH NHẠY CẢM (SECURITY & SECRETS)
# Tuyệt đối không đẩy API Key, Token hay mật khẩu lên Git
# ---------------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
config.secret.json
config.prod.json

# ---------------------------------------------------------------------
# 7. NỀN TẢNG DEPLOY HIỆN ĐẠI (MODERN DEPLOYMENT PLATFORMS)
# Dự phòng nếu sau này deploy lên Vercel/Netlify thay vì GitHub Pages
# ---------------------------------------------------------------------
.vercel/
.netlify/
.wrangler/
.deploy/
*.deploy.log

# ---------------------------------------------------------------------
# 8. CƠ SỞ DỮ LIỆU CỤC BỘ (LOCAL DATABASES)
# Phòng trường hợp phát triển tính năng tìm kiếm nâng cao với SQLite
# ---------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal

# ---------------------------------------------------------------------
# 9. DỰ ÁN VĂN ĐẠO - LƯU Ý ĐẶC BIỆT (PROJECT SPECIFIC)
# ⚠️ KHÔNG IGNORE các file sau (để hệ thống hoạt động):
# ---------------------------------------------------------------------
# 1. Dữ liệu gốc (Phải push lên để kích hoạt bot auto-split):
#    - data/data-tac-pham-master.json
#    - data/data-tac-gia-master.json
#
# 2. Cấu hình PWA & GitHub Pages:
#    - .nojekyll (Bắt buộc để giữ cấu trúc thư mục)
#    - manifest.json, index.html, sw.js
#
# 3. Trái tim hệ thống v2.0 (Knowledge Network):
#    - js/network/data-hub.js  (Trung tâm dữ liệu)
#    - js/ai.js                (Facade AI)
#    - js/ai/agents/*.js       (Các Agent chuyên môn)
#
# 4. Dữ liệu tri thức:
#    - data/tac-pham/*.json, data/tac-gia/*.json
#    - data/manifests/*.json (Bản đồ mạng lưới)
#    - tools/*.py (Script Python xử lý)

# Bỏ qua các file test/dữ liệu nháp do bạn tự tạo trong lúc phát triển
test_*.json
scratch.js
playground.html
data/test/
data/backup_*/
data/tac-pham-master.bak
data/tac-gia-master.bak

# Bỏ qua file nén / artifact nếu có ai đó vô tình tạo ra
*.zip
*.tar.gz
*.rar
*.7z
*.iso
*.dmg
